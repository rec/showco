{% macro repeated_item(element, item, items) %}
{% if element.layout == 'list' %}
<li class="{{ list_row_class(element.source, item) }}">{% for child in element.children %}{% if not loop.first %}{{ element.separator }}{% endif %}{% if child.format == 'time' %}<time class="error-time" data-value="{{ child.value }}" data-format="time">{{ item_text(child, status, item) }}</time>{% elif child.format == 'bold' %}<b data-value="{{ child.value }}">{{ item_text(child, status, item) }}</b>{% else %}<span data-value="{{ child.value }}" data-format="{{ child.format }}">{{ item_text(child, status, item) }}</span>{% endif %}{% endfor %}</li>
{% else %}
{% set row = row_data(element.source, item) %}
<div class="{{ row.class_name }}"{% for key, value in row.attributes.items() %} data-{{ key }}="{{ value }}"{% endfor %}>
  {% for child in element.children %}
    {% if child.kind == 'indicator' %}
      {% set active = bound_value(child.value, status, item) %}
      <span class="channel-state {{ 'indicator-red' if active else 'indicator-green' }}" data-element="{{ child.name }}" data-label="{{ child.label }}"
            aria-label="{{ 'recording' if active else 'not recording' }}"
            title="{{ child.label }}: {{ 'recording' if active else 'not recording' }}">•</span>
    {% elif child.kind == 'text_field' %}
      {% set text = bound_value(child.value, status, item) %}
      <label data-element="{{ child.name }}"><span class="channel-caption"><b>{{ text }}</b></span>
        <input name="{{ child.name }}" value="{{ text }}" aria-label="{{ child.label }}" data-action="{{ child.action }}">
      </label>
    {% elif child.kind == 'checkbox' %}
      {% set selected = bound_value(child.value, status, item) | length == 2 %}
      <label class="stereo" data-element="{{ child.name }}"><input type="checkbox" data-action="{{ child.action }}"{% if selected %} checked{% elif item and not is_enabled(child.enabled_when, item, items) %} disabled{% endif %}>{{ child.label }}</label>
    {% elif child.kind == 'waveform' %}
      <canvas class="waveform" aria-label="{{ child.label }}" data-element="{{ child.name }}"></canvas>
    {% elif child.kind == 'button' %}
      <button class="calibrate-channel" type="button" data-action="{{ child.action }}" data-element="{{ child.name }}">{{ child.label }}</button>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% for section in sections %}
<section data-section="{{ section.name }}"{% if section.style %} class="{{ section_class(section.style, status) }}"{% endif %}>
  {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
  {% if section.style in ['performance', 'transport'] %}<div class="{{ section.style }}"{% if section.style == 'transport' %} data-transport{% endif %}>{% endif %}
  {% for element in section.elements %}
    {% if element.kind == 'repeat' %}
      {% set items = bound_value(element.source, status, none) %}
      {% set visible = items[-element.limit:] if element.limit else items %}
      <div{% if element.layout == 'cards' %} class="levels"{% endif %} id="{{ element.name }}" data-source="{{ element.source }}" data-layout="{{ element.layout }}" data-limit="{{ element.limit }}" data-empty-text="{{ element.empty_text }}" data-template="{{ element.name }}-template">
      {% if visible %}
        {% if element.layout == 'list' %}<ul>{% endif %}
        {% for item in visible %}{{ repeated_item(element, item, items) }}{% endfor %}
        {% if element.layout == 'list' %}</ul>{% endif %}
      {% else %}<p>{{ element.empty_text }}</p>{% endif %}
      </div>
      <template id="{{ element.name }}-template">{{ repeated_item(element, none, items) }}</template>
    {% elif element.kind == 'button' %}
      {% if loop.first or loop.previtem.kind != 'button' %}<div class="channel-actions">{% endif %}
      <button type="button" data-operation="{{ element.operation }}" data-element="{{ element.name }}" id="{{ 'save-track-names' if element.operation == 'save_track_names' else 'revert-track-names' }}">{{ element.label }}</button>
      {% if loop.last or loop.nextitem.kind != 'button' %}</div>{% endif %}
    {% elif element.kind == 'text' %}
      <p data-element="{{ element.name }}">{{ element.label }}</p>
    {% elif element.kind == 'status' %}
      <p class="{{ status_class(element.format, status) }}" data-value="{{ element.value }}" data-format="{{ element.format }}" data-label="{{ element.label }}" id="{{ element.name }}">{% if element.label %}{{ element.label }}: {% endif %}{{ status_text(element, status) }}</p>
    {% elif element.kind == 'service_card' %}
      {% set service = bound_value(element.value, status, none) %}
      <article class="card {{ service.state }}" data-service="{{ element.value }}" data-format="{{ element.format }}" id="{{ element.name }}-card">
        <h2>{{ element.label }}</h2>
        <div class="state" id="{{ element.name }}-state">{{ service.state }}</div>
        <p class="service-detail" id="{{ element.name }}-detail">{{ service_text(element.format, status) }}</p>
      </article>
    {% elif element.kind == 'meter' %}
      {% set metric = metric_data(element.value, status) %}
      <div class="performance-row {{ metric.state }}" data-meter="{{ element.value }}" id="{{ element.name }}-performance">
        <b>{{ element.label }}</b>
        <meter id="{{ element.name }}-meter" min="0" max="100"{% if metric.percent is not none %} value="{{ '%.2f' | format(metric.percent) }}"{% endif %}></meter>
        <span id="{{ element.name }}-value">{{ metric.detail }}</span>
      </div>
    {% elif element.kind == 'mutable_attributes' %}
      <div class="attributes" id="{{ element.name }}" data-source="{{ element.source }}">
      {% if mutable_attributes['error'] %}
        <p>{{ mutable_attributes['error'] }}</p>
      {% elif mutable_attributes['items'] %}
        {% for attribute in mutable_attributes['items'] %}
          {% set field = attribute_field(attribute) %}
          <label class="mutable-attribute" data-address="{{ attribute.address }}" data-saved-value="{{ field.saved_value }}">
            {{ attribute.address }}
            <input type="{{ field.type }}" data-value-type="{{ field.value_type }}"{% if field.type != 'checkbox' %} value="{{ field.value }}"{% elif field.checked %} checked{% endif %}{% if field.type == 'number' %} step="any"{% endif %}>
          </label>
        {% endfor %}
      {% else %}<p>{{ element.empty_text }}</p>{% endif %}
      </div>
    {% elif element.kind == 'action_button' %}
      <form method="post" data-disabled-when="{{ element.disabled_when }}">
        <input type="hidden" name="action" value="{{ element.action }}">
        {% for name, value in element.parameters.items() %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
        <button{% if is_disabled(element, status) %} disabled{% endif %}>{{ element.label }}</button>
      </form>
    {% elif element.kind == 'action_result' %}
      <p id="{{ element.name }}" data-action-result aria-live="polite"></p>
    {% endif %}
  {% endfor %}
  {% if section.style in ['performance', 'transport'] %}</div>{% endif %}
</section>
{% endfor %}
