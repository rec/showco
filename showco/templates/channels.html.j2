{% macro channel_row(element, channel, channels) %}
<div class="level {{ channel.state if channel else '' }}" data-device="{{ channel.device if channel else '' }}"
     data-channel="{{ channel.name if channel else '' }}" data-channels="{{ channel.channels | join(',') if channel else '' }}"
     data-saved-track-name="{{ channel.name if channel else '' }}">
  {% for child in element.children %}
    {% if child.kind == 'indicator' %}
      <span class="channel-state {{ 'indicator-red' if channel and channel.on else 'indicator-green' }}" data-element="{{ child.name }}" data-label="{{ child.label }}"
            aria-label="{{ 'recording' if channel and channel.on else 'not recording' }}"
            title="{{ child.label }}: {{ 'recording' if channel and channel.on else 'not recording' }}">•</span>
    {% elif child.kind == 'text_field' %}
      <label data-element="{{ child.name }}"><span class="channel-caption"><b>{{ channel.name if channel else '' }}</b></span>
        <input name="track_name" value="{{ channel.name if channel else '' }}" aria-label="{{ child.label }}" data-action="{{ child.action }}">
      </label>
    {% elif child.kind == 'checkbox' %}
      <label class="stereo" data-element="{{ child.name }}"><input type="checkbox" data-action="{{ child.action }}"{% if channel and channel.channels | length == 2 %} checked{% elif channel and not stereo_enabled(channel, channels) %} disabled{% endif %}>{{ child.label }}</label>
    {% elif child.kind == 'waveform' %}
      <canvas class="waveform" aria-label="{{ child.label }}" data-element="{{ child.name }}"></canvas>
    {% elif child.kind == 'button' %}
      <button class="calibrate-channel" type="button" data-action="{{ child.action }}" data-element="{{ child.name }}">{{ child.label }}</button>
    {% endif %}
  {% endfor %}
</div>
{% endmacro %}

{% for section in sections %}
<section data-section="{{ section.name }}">
  <h2>{{ section.title }}</h2>
  {% for element in section.elements %}
    {% if element.kind == 'repeat' %}
      <div class="levels" id="channels" data-element="{{ element.name }}" data-empty-text="{{ element.empty_text }}">
      {% if channels %}
        {% for channel in channels %}{{ channel_row(element, channel, channels) }}{% endfor %}
      {% else %}<p>{{ element.empty_text }}</p>{% endif %}
      </div>
      <template id="channel-template">{{ channel_row(element, none, channels) }}</template>
    {% elif element.kind == 'button' %}
      {% if loop.first or loop.previtem.kind != 'button' %}<div class="channel-actions">{% endif %}
      <button type="button" data-operation="{{ element.operation }}" data-element="{{ element.name }}" id="{{ 'save-track-names' if element.operation == 'save_track_names' else 'revert-track-names' }}">{{ element.label }}</button>
      {% if loop.last or loop.nextitem.kind != 'button' %}</div>{% endif %}
    {% endif %}
  {% endfor %}
</section>
{% endfor %}
